<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedEquip Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand" asp-controller="Products" asp-action="Index">MedEquip Store</a>
            <nav class="site-nav d-flex align-items-center">
                <a asp-controller="Products" asp-action="Index">Catalog</a>
                <a asp-controller="Categories" asp-action="Index">Categories</a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="text-muted" style="margin-left: 1.5rem; font-size: 0.88rem;">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline; margin-left: 0.75rem;">
                        <button type="submit" class="btn btn-link" style="padding:0; font-size:0.92rem; font-weight:500; color:var(--color-steel); text-decoration:none;">Log Out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" style="margin-left: 1.5rem;">Log In</a>
                    <a asp-controller="Account" asp-action="Register">Register</a>
                }
            </nav>
        </div>
    </header>
    <div class="container" style="margin-top: 2.5rem; margin-bottom: 3rem;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MedEquipStore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
