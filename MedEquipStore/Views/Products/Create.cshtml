@model MedEquipStore.Models.Product

@{
    ViewData["Title"] = "افزودن محصول";
}

<div class="page-heading">
    <div>
        <h1>افزودن محصول</h1>
        <p>اطلاعات محصول جدید را وارد کنید.</p>
    </div>
</div>

<div class="form-card">
    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data"
          autocomplete="off">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">نام محصول</label>

            <input asp-for="Name"
                   class="form-control"
                   autocomplete="off"
                   placeholder="نام محصول را وارد کنید" />

            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label asp-for="PartNumber" class="form-label">شماره محصول</label>

                <input asp-for="PartNumber"
                       class="form-control"
                       autocomplete="off"
                       placeholder="مثلاً MED-1001" />

                <span asp-validation-for="PartNumber" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Manufacturer" class="form-label">تولیدکننده</label>

                <input asp-for="Manufacturer"
                       class="form-control"
                       autocomplete="off"
                       placeholder="نام شرکت یا تولیدکننده" />

                <span asp-validation-for="Manufacturer" class="text-danger"></span>
            </div>

        </div>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label">قیمت</label>

                <input asp-for="Price"
                       class="form-control"
                       autocomplete="off"
                       placeholder="قیمت محصول به ریال" />

                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="StockQuantity" class="form-label">موجودی انبار</label>

                <input asp-for="StockQuantity"
                       class="form-control"
                       autocomplete="off"
                       placeholder="تعداد موجود" />

                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>

        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">توضیحات محصول</label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="5"
                      autocomplete="off"
                      placeholder="توضیحات و مشخصات محصول را وارد کنید..."></textarea>

            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">دسته‌بندی</label>

            <select asp-for="CategoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select"
                    autocomplete="off">

                <option value="">انتخاب دسته‌بندی</option>

            </select>

            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">تصویر محصول</label>

            <input type="file"
                   name="imageFile"
                   class="form-control"
                   accept="image/*" />

            <div class="form-hint">
                تصویر مناسب محصول را انتخاب کنید.
            </div>
        </div>

        <div class="form-actions">

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                ایجاد محصول
            </button>

            <a asp-action="Index" class="btn btn-light">
                انصراف
            </a>

        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
