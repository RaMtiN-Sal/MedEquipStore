@model MedEquipStore.Models.Product

@{
    ViewData["Title"] = "حذف محصول";
}

<div class="delete-page">

    <div class="details-header">

        <div>
            <a asp-action="Index" class="details-back">
                <i class="bi bi-arrow-right"></i>
                بازگشت به محصولات
            </a>

            <h1>حذف محصول</h1>
        </div>

    </div>

    <div class="delete-card">

        <div class="delete-icon">
            <i class="bi bi-trash"></i>
        </div>

        <div class="delete-header">
            <h2>حذف «@Model.Name»</h2>

            <p>
                این عملیات غیرقابل بازگشت است و محصول برای همیشه حذف خواهد شد.
            </p>
        </div>

        <div class="delete-product-preview">

            <div class="delete-product-image">

                <img src="@(string.IsNullOrEmpty(Model.ImageUrl)
                                         ? "/images/no-image-placeholder.svg"
                                         : Model.ImageUrl)"
                     alt="@Model.Name" />

            </div>

            <div class="delete-product-info">

                <strong>@Model.Name</strong>

                <span>
                    شماره محصول:
                    @Model.PartNumber
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.Manufacturer))
                {
                    <span>
                        تولیدکننده:
                        @Model.Manufacturer
                    </span>
                }

            </div>

        </div>

        <div class="delete-details">

            <div>
                <span>قیمت</span>

                <strong>
                    @Model.Price.ToString("N0")
                    <small>ریال</small>
                </strong>
            </div>

            <div>
                <span>موجودی</span>

                <strong>
                    @Model.StockQuantity عدد
                </strong>
            </div>

        </div>

        <div class="delete-warning delete-warning-danger">

            <i class="bi bi-exclamation-triangle"></i>

            <span>
                پس از حذف، این محصول برای همیشه از فروشگاه حذف خواهد شد.
                این عملیات قابل بازگشت نیست.
            </span>

        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="ProductId" />

            <div class="delete-actions">

                <button type="submit"
                        class="btn btn-danger-custom">
                    <i class="bi bi-trash"></i>
                    حذف محصول
                </button>

                <a asp-action="Index"
                   class="btn btn-light">
                    انصراف
                </a>

            </div>

        </form>

    </div>

</div>
