@model IEnumerable<MedEquipStore.Models.Product>

@{
    ViewData["Title"] = "Catalog";
}

<div class="page-heading">
    <h1>Product Catalog</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">Add Product</a>
    }
</div>
<form asp-action="Index" method="get" class="mb-4 d-flex gap-2 flex-wrap align-items-center">
    <input type="text" name="searchTerm" value="@Context.Request.Query["searchTerm"]"
           class="form-control" placeholder="Search by name..." style="max-width: 220px;" />

    <select name="categoryId" class="form-select" style="max-width: 180px;">
        <option value="">All Categories</option>
        @foreach (var category in (List<MedEquipStore.Models.Category>)ViewBag.AllCategories)
        {
            var selectedId = Context.Request.Query["categoryId"];
            <option value="@category.CategoryId" selected="@(selectedId == category.CategoryId.ToString())">
                @category.Name
            </option>
        }
    </select>

    <input type="number" name="minPrice" value="@Context.Request.Query["minPrice"]"
           class="form-control" placeholder="Min $" style="max-width: 110px;" step="0.1" min="0" />

    <input type="number" name="maxPrice" value="@Context.Request.Query["maxPrice"]"
           class="form-control" placeholder="Max $" style="max-width: 110px;" step="0.1" min="0" />

    @{
        var currentSort = Context.Request.Query["sortOrder"].ToString();
    }
    <select name="sortOrder" class="form-select" style="max-width: 180px;">
        <option value="" selected="@(currentSort == "")">Sort: Name</option>
        <option value="price_asc" selected="@(currentSort == "price_asc")">Price: Low to High</option>
        <option value="price_desc" selected="@(currentSort == "price_desc")">Price: High to Low</option>
        <option value="stock_asc" selected="@(currentSort == "stock_asc")">Stock: Low to High</option>
        <option value="stock_desc" selected="@(currentSort == "stock_desc")">Stock: High to Low</option>
    </select>

    <button type="submit" class="btn btn-primary">Apply</button>
    <a asp-action="Index" class="btn btn-link text-muted">Clear</a>
</form>
@{
    bool hasAnyFilter = !string.IsNullOrEmpty(Context.Request.Query["searchTerm"])
        || !string.IsNullOrEmpty(Context.Request.Query["categoryId"])
        || !string.IsNullOrEmpty(Context.Request.Query["minPrice"])
        || !string.IsNullOrEmpty(Context.Request.Query["maxPrice"]);
}

@if (!Model.Any() && hasAnyFilter)
{
    <p class="text-muted">No products match your filters. <a asp-action="Index">Clear filters</a></p>
}
else if (!Model.Any() && User.IsInRole("Admin"))
{
    <p class="text-muted">No products yet. <a asp-action="Create">Add your first product.</a></p>
}
else if (!Model.Any())
{
    <p class="text-muted">No products found.</p>
}
else
{
    <table class="catalog-table">
        <thead>
            <tr>
                <th></th>
				<th>Product</th>
				<th>Category</th>
                <th>Part No.</th>
                <th>Manufacturer</th>
                <th>Price</th>
                <th>Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td style="width: 56px;">
                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image-placeholder.svg" : product.ImageUrl)"
                             alt="@product.Name" style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-border);" />
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@product.ProductId" class="product-name" style="text-decoration:none;">
                            @product.Name
                        </a>
                    </td>
                    <td>
                        @if (product.Category != null)
                        {
                            <span>@product.Category.Name</span>
                        }
                        else
                        {
                            <span class="text-muted">Uncategorized</span>
                        }
                    </td>
                    <td><span class="product-partno">@product.PartNumber</span></td>
                    <td>@product.Manufacturer</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>
                        @{
                            var stockClass = product.StockQuantity == 0 ? "stock-out"
                            : product.StockQuantity <= 5 ? "stock-low"
                            : "stock-in";
                            var stockLabel = product.StockQuantity == 0 ? "Out of stock"
                            : product.StockQuantity <= 5 ? $"{product.StockQuantity} left"
                            : $"{product.StockQuantity} in stock";
                        }
                        <span class="stock-pill @stockClass">@stockLabel</span>
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@product.ProductId" class="text-muted" style="text-decoration:none; font-size:0.85rem;">Edit</a>
                            <span>&nbsp;·&nbsp;</span>
                            <a asp-action="Delete" asp-route-id="@product.ProductId" class="text-muted" style="text-decoration:none; font-size:0.85rem;">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}