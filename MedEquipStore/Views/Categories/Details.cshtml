@model MedEquipStore.Models.Category

@{
    ViewData["Title"] = Model.Name;
}

<div class="page-heading">
    <h1>@Model.Name</h1>
    <div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary btn-sm">Edit</a>
        }
        <a asp-action="Index" class="btn btn-link btn-sm text-muted">Back to Categories</a>
    </div>
</div>

<div class="d-flex gap-4 flex-wrap align-items-start">
    <div class="form-card" style="flex: 0 0 300px;">
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image-placeholder.svg" : Model.ImageUrl)"
             alt="@Model.Name" style="width: 100%; border-radius: 6px; border: 1px solid var(--color-border); margin-bottom: 1.25rem;" />

        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted" style="font-weight:500; font-size:0.85rem;">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4 text-muted" style="font-weight:500; font-size:0.85rem;">Products</dt>
            <dd class="col-sm-8">@Model.Products.Count product(s)</dd>
        </dl>
    </div>

    <div style="flex: 1 1 400px;">
        @if (Model.Products.Any())
        {
            <table class="catalog-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Product</th>
                        <th>Part No.</th>
                        <th>Price</th>
                        <th>Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td style="width: 56px;">
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image-placeholder.svg" : product.ImageUrl)"
                                     alt="@product.Name" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid var(--color-border);" />
                            </td>
                            <td>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId" class="product-name" style="text-decoration:none;">
                                    @product.Name
                                </a>
                            </td>
                            <td><span class="product-partno">@product.PartNumber</span></td>
                            <td>@product.Price.ToString("C")</td>
                            <td>@product.StockQuantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No products in this category yet.</p>
        }
    </div>
</div>