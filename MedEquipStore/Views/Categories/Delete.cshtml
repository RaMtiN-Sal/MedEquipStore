@model MedEquipStore.Models.Category

@{
    ViewData["Title"] = "حذف دسته‌بندی";
    var productCount = Model.Products.Count;
}

<div class="delete-page">

    <div class="details-header">

        <div>
            <a asp-action="Index" class="details-back">
                <i class="bi bi-arrow-right"></i>
                بازگشت به دسته‌بندی‌ها
            </a>

            <h1>حذف دسته‌بندی</h1>
        </div>

    </div>

    <div class="delete-card">

        <div class="delete-icon">
            <i class="bi bi-trash"></i>
        </div>

        <div class="delete-header">
            <h2>حذف «@Model.Name»</h2>
            <p>
                این عملیات می‌تواند غیرقابل بازگشت باشد.
            </p>
        </div>

        <div class="delete-details">

            <div>
                <span>نام دسته‌بندی</span>
                <strong>@Model.Name</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div>
                    <span>توضیحات</span>
                    <strong>@Model.Description</strong>
                </div>
            }

            <div>
                <span>تعداد محصولات</span>
                <strong>@productCount محصول</strong>
            </div>

        </div>

        @if (productCount == 0)
        {
            <div class="delete-warning">
                <i class="bi bi-exclamation-triangle"></i>

                <span>
                    این دسته‌بندی محصولی ندارد و می‌توانید آن را حذف کنید.
                </span>
            </div>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="CategoryId" />

                <div class="delete-actions">

                    <button type="submit"
                            class="btn btn-danger-custom">
                        <i class="bi bi-trash"></i>
                        حذف دسته‌بندی
                    </button>

                    <a asp-action="Index"
                       class="btn btn-light">
                        انصراف
                    </a>

                </div>

            </form>
        }
        else
        {
            <div class="delete-warning delete-warning-danger">
                <i class="bi bi-exclamation-triangle"></i>

                <span>
                    این دسته‌بندی دارای
                    <strong>@productCount محصول</strong>
                    است.
                    انتخاب کنید که فقط دسته‌بندی حذف شود یا محصولات آن نیز حذف شوند.
                </span>
            </div>

            <div class="delete-actions delete-actions-wrap">

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="CategoryId" />

                    <button type="submit"
                            class="btn btn-outline-danger-custom">
                        <i class="bi bi-folder-x"></i>
                        حذف فقط دسته‌بندی
                    </button>

                    <small>
                        محصولات بدون دسته‌بندی باقی می‌مانند.
                    </small>

                </form>

                <form asp-action="DeleteWithProducts" method="post">

                    <input type="hidden" asp-for="CategoryId" />

                    <button type="submit"
                            class="btn btn-danger-custom">
                        <i class="bi bi-trash3"></i>
                        حذف دسته‌بندی و محصولات
                    </button>

                    <small>
                        هر @productCount محصول نیز حذف خواهد شد.
                    </small>

                </form>

                <a asp-action="Index"
                   class="btn btn-light">
                    انصراف
                </a>

            </div>
        }

    </div>

</div>